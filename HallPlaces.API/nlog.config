<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true">

  <!-- One log line: time | level | CorrelationId | who wrote it | message (+ the exception, if any) -->
  <variable name="line"
            value="${longdate}|${level:uppercase=true}|${scopeproperty:CorrelationId}|${logger:shortName=true}|${message} ${exception:format=tostring}" />

  <targets>
    <!-- The console: what you see in Visual Studio / in the Render logs page -->
    <target xsi:type="Console" name="console" layout="${line}" />

    <!-- A file per day, in the logs folder (not committed: see .gitignore) -->
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/hallplaces-${shortdate}.log"
            layout="${line}"
            keepFileOpen="false"
            maxArchiveFiles="14" />
  </targets>

  <rules>
    <!-- Framework noise (Microsoft.*, System.*) is shown only from Warning up. "final" = stop here for those. -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.*" maxlevel="Info" final="true" />

    <!-- Our own code: Information and above, to both targets -->
    <logger name="*" minlevel="Info" writeTo="console,file" />
  </rules>
</nlog>
